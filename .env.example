# Copy this file to .env before starting the Docker Compose stack.
# Replace local passwords and signing keys with private values.

POSTGRES_USER=chatbase
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=chatbase_db

SECRET_KEY=replace-with-a-long-random-secret

# At least one provider key is needed for live assistant responses.
GROQ_API_KEY=
OPENAI_API_KEY=
